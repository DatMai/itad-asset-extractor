# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent tooling state
.claude/.cc-writes/
.claude/settings.local.json

# pnpm store created when installing inside a sandbox
.pnpm-store/

# working folders of the research step; the kept copies are in .local-map/research
/research_notes/
/reports/

# playwright
/test-results/
/playwright-report/
